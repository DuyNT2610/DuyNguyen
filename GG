        "#@title Tính tổng chi tiêu và số tiền còn lại { display-mode: \"form\" }\n",
        "\n",
        "def calculate_expenses(expenses):\n",
        "\n",
        "    return sum(expenses)\n",
        "\n",
        "expenses = [food, travel, move, study, entertainment, other]\n",
        "\n",
        "total_expenses = calculate_expenses(expenses)\n",
        "remaining = budget - total_expenses\n",
        "\n",
        "print(f\"Tổng chi tiêu: {total_expenses:,.0f} đồng\")\n",
        "print(f\"Số tiền còn lại: {remaining:,.0f} đồng\")"
