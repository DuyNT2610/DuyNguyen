        "#@title Đánh giá tình hình ngân sách { display-mode: \"form\" }\n",
        "\n",
        "def evaluate_budget(budget, total_expenses):\n",
        "    percentage = (total_expenses / budget) * 100\n",
        "\n",
        "    if total_expenses > budget:\n",
        "        print(\"Cảnh báo: Chi tiêu vượt ngân sách!\")\n",
        "    elif percentage >= 80:\n",
        "        print(\"Cảnh báo: Cần hạn chế chi tiêu!\")\n",
        "    else:\n",
        "        print(\"Chi tiêu đang trong giới hạn cho phép.\")\n",
        "\n",
        "    print(f\"Tỷ lệ sử dụng ngân sách: {percentage:.2f}%\")\n",
        "\n",
        "evaluate_budget(budget, total_expenses)"
